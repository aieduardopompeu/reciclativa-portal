# Copie para .env.local e preencha com os valores reais (nunca comite .env.local).

# Banco de dados (Neon / Vercel Postgres)
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""
NEON_PROJECT_ID=""
PGDATABASE=""
PGHOST=""
PGHOST_UNPOOLED=""
PGPASSWORD=""
PGUSER=""
POSTGRES_DATABASE=""
POSTGRES_HOST=""
POSTGRES_PASSWORD=""
POSTGRES_PRISMA_URL=""
POSTGRES_URL=""
POSTGRES_URL_NON_POOLING=""
POSTGRES_URL_NO_SSL=""
POSTGRES_USER=""

# Site
NEXT_PUBLIC_SITE_URL="https://www.reciclativa.com"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_GA4_ID=""

# Admin
ADMIN_TOKEN=""
ADMIN_PASSWORD=""
NEXT_PUBLIC_SHOW_ADMIN_LINK="true"

# E-mail (Resend)
RESEND_API_KEY=""
RESEND_FROM="Reciclativa <cadastro@reciclativa.com>"
GESTAO_NOTIFY_EMAIL=""

# Radar Ambiental — clipping editorial com aprovação via Telegram
# Chave exigida no header X-API-Key do POST /api/radar/ingest.
RADAR_API_KEY=""
# Bot do Telegram usado para notificar a equipe quando uma matéria de alta
# relevância entra na fila. Crie um bot com o @BotFather, pegue o token, e o
# chat_id de quem vai receber (ou de um grupo). Enquanto não configurados, a
# mensagem é apenas logada (nada é enviado, nada quebra).
RADAR_TELEGRAM_BOT_TOKEN=""
RADAR_TELEGRAM_CHAT_ID=""
# TTL do cache em memória de GET /api/radar/home, em segundos.
RADAR_CACHE_TTL=900
# true = publica sem aprovação humana ao dar ingest (NÃO recomendado).
RADAR_AUTO_PUBLISH=false
# Relevância mínima (1-5) para disparar a notificação de aprovação via Telegram.
RADAR_MIN_RELEVANCIA=4
# Busca (Tavily) + redação automática (OpenAI) usadas pelo botão "Buscar
# notícias" em /admin/radar. Sem essas chaves, o botão retorna erro amigável.
TAVILY_API_KEY=""
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
